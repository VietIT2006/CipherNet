# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.java text eol=lf
*.gradle text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Scripts
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.docx binary
